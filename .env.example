# GoHighLevel — server-only (set in Vercel Project → Environment Variables)
# Local: copy to .env.local (never commit .env.local)
#
# Use GHL_DRY_RUN=true for UI testing without calling the CRM (optional).

GHL_DRY_RUN=false

# Private Integration Token (PIT) — Authorization: Bearer
GHL_API_KEY=

# Sub-account / location ID (M2M Team Leads)
GHL_LOCATION_ID=

# API defaults (override only if HighLevel changes base URL or version)
# GHL_API_BASE_URL=https://services.leadconnectorhq.com
# GHL_API_VERSION=2021-07-28

# Custom field IDs (UUIDs from GHL → Settings → Custom Fields → Contact)
GHL_CF_DOB=
GHL_CF_ADDRESS=
GHL_CF_URGENCY=
GHL_CF_LEAD_TYPE=
GHL_CF_UTM_SOURCE=
GHL_CF_UTM_MEDIUM=
GHL_CF_UTM_CAMPAIGN=
GHL_CF_UTM_CONTENT=

# Pipelines & default “New Inquiry” stage IDs (per sub-account)
GHL_BUYER_PIPELINE_ID=
GHL_SELLER_PIPELINE_ID=
GHL_BUYER_STAGE_NEW_INQUIRY_ID=
GHL_SELLER_STAGE_NEW_INQUIRY_ID=

# Comma-separated tag names (must exist in GHL)
GHL_TAG_LEAD_BUYER=
GHL_TAG_LEAD_SELLER=

# Optional: extra tags by pathname — "/cma-form:Tag A|Tag B,/sell:Tag C"
# GHL_PATH_TAGS=
