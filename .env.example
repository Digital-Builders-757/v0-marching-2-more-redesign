# GoHighLevel — server-only (set in Vercel Project → Environment Variables)
# Local: copy to .env.local (never commit .env.local)
#
# Use GHL_DRY_RUN=true for UI testing without calling the CRM (optional).
#
# Operator verification: npm run ghl:operator-check
#   Optional: npm run ghl:operator-check -- --ping  (token + location read check; no secrets printed)
# Full assumptions + triage: docs/M2M_GHL_OPERATOR_VERIFICATION.md

GHL_DRY_RUN=false

# Private Integration Token (PIT) — Authorization: Bearer
GHL_API_KEY=

# Sub-account / location ID (M2M Team Leads)
GHL_LOCATION_ID=

# API defaults (override only if HighLevel changes base URL or version)
# GHL_API_BASE_URL=https://services.leadconnectorhq.com
# GHL_API_VERSION=2021-07-28

# Custom field IDs (GHL → Settings → Custom Fields → Contact — copy field id, not only label)
# GHL_CF_ADDRESS → field labeled "Property Address" in M2M account
# GHL_CF_URGENCY → TEXT urgency field id (not the dropdown urgency field; frontend uses shared
#   timeline labels — see docs/M2M_GHL_INTEGRATION_MASTER_PLAN.md "Lead capture routes")
GHL_CF_DOB=
GHL_CF_ADDRESS=
GHL_CF_URGENCY=
GHL_CF_LEAD_TYPE=
GHL_CF_UTM_SOURCE=
GHL_CF_UTM_MEDIUM=
GHL_CF_UTM_CAMPAIGN=
GHL_CF_UTM_CONTENT=

# Pipelines & default “New Inquiry” stage IDs (per sub-account)
GHL_BUYER_PIPELINE_ID=
GHL_SELLER_PIPELINE_ID=
GHL_BUYER_STAGE_NEW_INQUIRY_ID=
GHL_SELLER_STAGE_NEW_INQUIRY_ID=

# Comma-separated tag names — must match GHL exactly (spacing, ASCII hyphen; avoid Word/en-dash paste)
# Example: M2M - Buyer   and   M2M - Seller
GHL_TAG_LEAD_BUYER=
GHL_TAG_LEAD_SELLER=

# Optional: extra tags by pathname — "/cma-form:Tag A|Tag B,/sell:Tag C"
# GHL_PATH_TAGS=
